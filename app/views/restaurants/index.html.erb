<h1 class="text-3xl font-bold mb-6">Restaurants</h1>

<div class="grid gap-6 md:grid-cols-3">
  <% @restaurants.each do |restaurant| %>
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold"><%= restaurant.name %></h2>
      <p class="text-gray-500 capitalize mb-4"><%= restaurant.category %></p>
      <%= link_to "See details", restaurant_path(restaurant), class: "text-blue-600 hover:underline" %>
    </div>
  <% end %>
</div>
