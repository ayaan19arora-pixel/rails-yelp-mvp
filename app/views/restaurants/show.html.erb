<div class="bg-white rounded-lg shadow p-6 mb-8">
  <h1 class="text-3xl font-bold mb-4"><%= @restaurant.name %></h1>
  <p class="text-gray-700"><span class="font-semibold">Category:</span> <%= @restaurant.category %></p>
  <p class="text-gray-700"><span class="font-semibold">Address:</span> <%= @restaurant.address %></p>
  <p class="text-gray-700"><span class="font-semibold">Phone:</span> <%= @restaurant.phone_number %></p>
</div>

<h2 class="text-2xl font-bold mb-4">Reviews</h2>

<% if @restaurant.reviews.empty? %>
  <p class="text-gray-500 mb-4">No reviews yet.</p>
<% else %>
  <div class="space-y-4 mb-6">
    <% @restaurant.reviews.each do |review| %>
      <div class="bg-white rounded-lg shadow p-4">
        <p class="font-semibold"><%= review.rating %>/5</p>
        <p class="text-gray-700"><%= review.content %></p>
      </div>
    <% end %>
  </div>
<% end %>

<div class="flex gap-4">
  <%= link_to "Add a review", new_restaurant_review_path(@restaurant), class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  <%= link_to "Back to restaurants", restaurants_path, class: "px-4 py-2 text-blue-600 hover:underline" %>
</div>
